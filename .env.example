# Copy this file to .env and set the secret only on your local machine.
# Do not enable AI until its implementation and spending controls are reviewed.
ANTHROPIC_API_KEY=
MARSIGHT_CLAUDE_ENABLED=false
MARSIGHT_CLAUDE_PROJECT_CAP_USD=25
MARSIGHT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: absolute path to the approved HiRISE raster on the API host. Leave empty when unavailable.
MARSIGHT_DTM_PATH=

# USGS planetary STAC API base URL.
MARSIGHT_STAC_URL=https://stac.astrogeology.usgs.gov/api
